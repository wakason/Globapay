{
  "name": "app_backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm migration:generate -- -d src/config/migration-data-source.ts",
    "migration:create": "npm run typeorm migration:create -- src/migrations",
    "migration:run": "ts-node scripts/migration-up.ts",
    "migration:revert": "ts-node scripts/migration-down.ts",
    "migration:show": "ts-node scripts/migration-status.ts",
    "seed:initial": "ts-node scripts/seed-initial.ts",
    "seed:employees": "node scripts/seed-employees.js",
    "db:reset": "cross-env NODE_ENV=development ts-node scripts/db-reset.ts",
    "db:setup": "npm run migration:run && npm run seed:initial",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.15.1",
    "reflect-metadata": "^0.2.2",
    "ts-node-dev": "^2.0.0",
    "typeorm": "^0.3.27",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/morgan": "^1.9.10"
  }
}
